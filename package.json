{
  "name": "carrera-extrema-fotos",
  "version": "1.0.0",
  "private": true,
  "description": "Galería de fotos descargables de la Carrera Extrema Sportline",
  "type": "module",
  "scripts": {
    "fotos": "node procesar-fotos.mjs",
    "ver": "npx --yes serve@14.2.4 site -l 4321",
    "publicar": "git subtree push --prefix site origin gh-pages",
    "deploy": "wrangler deploy",
    "instalar-lector": "python -m venv .venv && .venv/Scripts/python -m pip install -r requirements.txt"
  },
  "dependencies": {
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
